# =============================================================================
# MCP Agent Mesh -- Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
# Do NOT commit .env to version control.

# --- Application ---
ENV=development
DEBUG=false
LOG_LEVEL=INFO
APP_NAME="MCP Agent Mesh"
APP_VERSION=1.0.0

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=["*"]

# --- Authentication ---
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_GPT4O_MINI=gpt-4o-mini

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
REDIS_CONTEXT_TTL_SECONDS=7200
REDIS_REGISTRY_TTL_SECONDS=120

# --- Qdrant (Vector DB) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=knowledge_base
QDRANT_EMBEDDING_DIM=1536

# --- Cosmos DB (Production only) ---
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE_NAME=agentmesh
COSMOS_TASK_CONTAINER=tasks
COSMOS_AUDIT_CONTAINER=audit_log

# --- Azure Blob Storage (Production only) ---
BLOB_CONNECTION_STRING=
BLOB_CONTAINER_DATA=data
BLOB_CONTAINER_REPORTS=reports

# --- Langfuse (Observability) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Agent Configuration ---
AGENT_DEFAULT_TIMEOUT_SECONDS=60
AGENT_MAX_RETRIES=3
AGENT_HEARTBEAT_INTERVAL_SECONDS=30

# --- Budget ---
TASK_BUDGET_LIMIT_USD=1.00
BUDGET_WARNING_THRESHOLD=0.80

# --- Guardian Thresholds ---
GUARDIAN_AUTO_APPROVE_THRESHOLD=0.85
GUARDIAN_WARNING_THRESHOLD=0.60
GUARDIAN_REPROCESS_THRESHOLD=0.40

# --- HITL (Human in the Loop) ---
HITL_TIMEOUT_MINUTES=30

# --- MCP Cache ---
MCP_CACHE_TTL_SECONDS=300

# --- Dashboard ---
DASHBOARD_PORT=8501
WEBSOCKET_URL=ws://localhost:8000/ws
